{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@server/*": ["./*"]
    }
  },
  "include": [
    "src/db/seed.ts",
    "src/db/seed-images.ts",
    "src/db/source-image-object-key-resolver.ts",
    "src/lib/minio-client.ts",
    "src/lib/parse-date.ts",
    "../frontend/src/data/blog-content.ts",
    "../frontend/src/data/blog.ts",
    "../frontend/src/data/categories.ts",
    "../frontend/src/data/products.ts",
    "../frontend/src/data/stores.ts",
    "../frontend/src/data/types.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
